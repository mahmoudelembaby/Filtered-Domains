# website-filter v1 — Jev-only, Redis + SQLite
# Copy to .env and adjust.

APP_NAME=website-filter
APP_ENV=dev
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

# Admin auth: set to require X-Admin-Key on /admin/* . Empty = allow (dev only).
ADMIN_API_KEY=changeme

# Policy
ALLOW_THRESHOLD=0.90
BLOCK_THRESHOLD=0.90
POLICY_VERSION=1.0

# Cache TTLs (seconds)
ALLOW_TTL=86400
BLOCK_TTL=21600
REVIEW_TTL=1800

# Redis (fast cache). If unreachable, app falls back to in-memory cache.
REDIS_URL=redis://localhost:6379/0

# SQLite (persistent source of truth + audit)
SQLITE_PATH=./data/website_filter.db

# Metadata fetcher
FETCH_TIMEOUT_S=8.0
FETCH_CONNECT_TIMEOUT_S=3.0
FETCH_MAX_BYTES=1000000
FETCH_MAX_REDIRECTS=3
FETCH_USER_AGENT=website-filter/1.0 (+internal IT use)

# Jev TypeSafe AI (primary classifier)
# If JEV_API_URL is empty, JevModel runs in heuristic stand-in mode
# (model="jev-heuristic") so v1 works offline. Set URL+KEY for production.
JEV_API_URL=
JEV_API_KEY=
JEV_MODEL_VERSION=1.x
JEV_TIMEOUT_MS=5000
JEV_MODE=auto
